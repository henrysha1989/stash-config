# ==============================================================================
#  Soul 去广告（升级版）
# ------------------------------------------------------------------------------
#  基线：社区版 Soul_remove_ads.stoverride（clashios.app / lodepuly，2024-07）
#  升级来源：
#   · Xo776/byead 的 soul_ads.conf v0.7（2026-06-16，仍在维护，含误伤说明 COLLATERAL.md）
#   · 2026-10-19 本机 ProxyPin 抓包（ssp / api-a / post / ad-r 等真实路径）
#
#  相对社区版修了四处：
#   1) **规则顺序**：社区版把 `DOMAIN-SUFFIX,soulapp.cn,DIRECT` 排在最前，
#      后面所有 `*.soulapp.cn` 的 REJECT 全是死规则。本版把 REJECT 放前面、直连放最后。
#   2) **补 2026 新增广告子域**：soul-commercial / marketing-openapi / ad-brand-activity /
#      ad-reward-test —— 社区版没有，靠 soul-ad.list 漏掉的那部分。
#   3) **放行功能域**：increase-openapi.soulapp.cn 是聊天横幅开关（不是广告），
#      我们的 soul-ad.list 曾整域拦它，本覆写用直连规则把它捞回来。
#   4) **ssp 路径级兜底**：域名层已整域拦 ssp，这里再加一层 reject-dict，
#      用于 App 改用 IP 直连绕过域名拦截的场景。
#
#  ⚠️ 没搬的部分：Xo776 那套有 10 多个 JS 脚本（信息流剔除伪装帖、话题热榜、礼物榜、
#     青少年弹窗等），要逐个适配成 Stash 的 script-providers 才能用。当前先做域名 + 路径这层，
#     收益最大的是开屏与广告位，信息流残留属于后续可选项。
# ==============================================================================
name: Soul 去广告（升级版）
desc: 广告子域 REJECT + 功能域放行 + ssp 路径兜底；基线社区版，补 2026 新增域名

rules:
  # ---- 广告子域（必须排在下面的 soulapp.cn 直连之前）----
  - DOMAIN,ad.soulapp.cn,REJECT
  - DOMAIN,ads.soulapp.cn,REJECT
  - DOMAIN,ad-r.soulapp.cn,REJECT
  - DOMAIN,ad-h5-cdn.soulapp.cn,REJECT
  - DOMAIN,ad-h5-station-cdn.soulapp.cn,REJECT
  - DOMAIN,ad-static.soulapp.cn,REJECT
  - DOMAIN,ad-reward.soulapp.cn,REJECT
  - DOMAIN,ad-reward-test.soulapp.cn,REJECT
  - DOMAIN,ad-audit-provider.soulapp.cn,REJECT
  - DOMAIN,ad-brand-activity.soulapp.cn,REJECT
  - DOMAIN,soul-ad.soulapp.cn,REJECT
  - DOMAIN,soul-commercial.soulapp.cn,REJECT
  - DOMAIN,soul-report.soulapp.cn,REJECT
  - DOMAIN,marketing-openapi.soulapp.cn,REJECT
  - DOMAIN,ssp.soulapp.cn,REJECT
  - DOMAIN,splash.soulapp.cn,REJECT

  # ---- 功能域：放行（soul-ad.list 误拦过的）----
  - DOMAIN-SUFFIX,increase-openapi.soulapp.cn,ST-国内直连
  - DOMAIN-SUFFIX,gateway2-tcp-spam.soulapp.cn,ST-国内直连
  - DOMAIN-SUFFIX,handshake.gtnetwork.soulapp.cn,ST-国内直连

  # ---- 其余 Soul 流量直连（最后一条，不能再往后加 REJECT）----
  - DOMAIN-SUFFIX,soulapp.cn,ST-国内直连

http:
  mitm:
    - ssp.soulapp.cn
    - api-a.soulapp.cn
    - api-account.soulapp.cn
    - api-chat.soulapp.cn
    - api-user.soulapp.cn
    - chat-live.soulapp.cn
    - gateway-mobile-gray.soulapp.cn
    - post.soulapp.cn
    - 47.110.187.87

  url-rewrite:
    # ssp 竞价与广告配置（域名已被 REJECT，这一层给 IP 直连绕过的场景兜底）
    - ^https?://ssp\.soulapp\.cn/api/(q|bidResult|ad/) - reject-dict
    - ^https?://ssp\.soulapp\.cn/api/materialCacheConfig - reject-dict

  script:
    # 广告/推广配置：内容见 scripts/soul-ad-clean.js（fmz200 版精简，已去掉解锁逻辑）
    - match: ^https?://api-account\.soulapp\.cn/teenager/config
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://api-a\.soulapp\.cn/v\d/post/gift/list
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://api-a\.soulapp\.cn/official/scene/module
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://api-user\.soulapp\.cn/furion/position/content
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://api-user\.soulapp\.cn/v\d/planet/config
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://post\.soulapp\.cn/hot/soul/rank
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://post\.soulapp\.cn/v\d/post/homepage/guide/card
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://post\.soulapp\.cn/v\d/post/recSquare/subTabs
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://chat-live\.soulapp\.cn/chatroom/chatClassifyRoomList
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://gateway-mobile-gray\.soulapp\.cn/mobile/app/version/queryIos
      name: soul-ad-clean
      type: response
      require-body: true
    - match: ^https?://47\.110\.187\.87/winterfell/
      name: soul-ad-clean
      type: response
      require-body: true

script-providers:
  soul-ad-clean:
    # 内联，避免远程下载失败导致脚本不生效（与 scripts/soul-ad-clean.js 同源）
    payload: |
      // Soul 去广告（精简移植版）
      //
      // 来源：fmz200/wool_scripts — Scripts/soul/soul_ads.js（2024-06-13，作者 fmz200，引用 ZenmoFeiShi）
      //       https://github.com/fmz200/wool_scripts/blob/main/Scripts/soul/soul_ads.js
      //
      // 本次移植做的裁剪：
      //   1) 去掉 `$.Env` 框架（15 KB 里的 12 KB 是框架，只用到 $done）
      //   2) **去掉 `/chat/limitInfo` 的 limit=false** —— 那是解锁付费能力，不属于去广告
      //   3) 去掉无实际逻辑的空分支（chatroom 清空、recSquare 过滤，原版已注释）
      //   4) 保留：广告/推广配置的 data 清空、游戏推广卡片过滤、卡片样式归一
      //
      // 适用端点（见 soul.stoverride 的 http.script 列表）；
      // 每个都要求返回体是 JSON，解析失败时原样放行。

      const url = $request.url || '';
      const body = ($response && $response.body) || '{}';

      let obj;
      try {
        obj = JSON.parse(body);
      } catch (e) {
        $done({}); // 不是 JSON，不动
      }

      // 广告 / 推广配置类：把 data 清空（原版是 delete data，这里给 {} 保持结构）
      const CLEAR_DATA = [
        '/post/homepage/guide/card',
        '/furion/position/content',
        '/hot/soul/rank',
        '/post/gift/list',
        '/mobile/app/version/queryIos',
        '/teenager/config',
        '/winterfell/v2/getIpByDomain',
        '/official/scene/module'
      ];

      // 星球页里要剔除的推广卡片
      const GAMES = ['异世界回响', '狼人魅影', '梦想海岛王', '幻想星球', '爆弹喵', '星球实验室', '兴趣群组', '群聊派对'];

      if (obj && typeof obj === 'object') {
        if (obj.data && CLEAR_DATA.some((p) => url.indexOf(p) >= 0)) {
          obj.data = {};
        }

        if (url.indexOf('/v6/planet/config') >= 0 && obj.data) {
          if (obj.data.gameInfo && Array.isArray(obj.data.gameInfo.gameCards)) {
            obj.data.gameInfo.gameCards = obj.data.gameInfo.gameCards.filter((c) => GAMES.indexOf(c.title) < 0);
          }
          if (Array.isArray(obj.data.coreCards)) {
            obj.data.coreCards = obj.data.coreCards
              .filter((c) => GAMES.indexOf(c.title) < 0)
              .map((c) => {
                if (Array.isArray(c.secondCards)) {
                  c.secondCards = c.secondCards.filter((s) => GAMES.indexOf(s.title) < 0);
                }
                return c;
              });
          }
        }

        if (obj.data && Array.isArray(obj.data.coreCards)) {
          obj.data.coreCards.forEach((c) => {
            if (c.style === 2) c.style = 1;
          });
        }
      }

      $done({ body: JSON.stringify(obj) });
