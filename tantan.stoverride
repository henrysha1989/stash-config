# ==============================================================================
#  探探去广告（路径级 / MitM）
# ------------------------------------------------------------------------------
#  2026-10-20 抓包（ProxyPin，冷启动，core.tantanapp.com）确认的开屏链路：
#    POST /v2/ad/configuration      435 B  ← 开屏策略：GDT 竞价（两个 placementId）
#    POST /v2/ad/aaid               162 B
#    GET  /v2/ad-data               2 B（空）
#    GET  /v2/ad/material/*         素材清单
#    GET  /v2/oms/me/creatives      187 B  ← 广告创意清单
#    GET  /v2/monetization/strategy/configuration
#    GET  /v2/monetization-promotions
#    GET  /v2/users/{id}/advert/tantan-advert/query
#
#  策略分两种，别再混用：
#   · /v2/ad/configuration → 用 script 返回「没有广告位」的**合法结构**（见 scripts/tantan-ad-config.js）
#     直接 reject-dict 回 "{}" 会让 App 可能回退到内置默认配置，反而不稳。
#   · 其余路径 → reject-dict（回空 JSON，App 不崩）
#
#  ⚠️ 已知风险
#   · MitM 解密 core.tantanapp.com 的全部流量（主 API）；pinning 会导致连不上
#   · GDT / 穿山甲 / tanx 等第三方 SDK 域名由规则集在域名层拦，不在这里重复
#   · 若开屏仍出现，先确认是不是 **feed 推广卡片**（/v2/users 响应里混排，规则无解）
# ==============================================================================
name: 探探去广告（路径级）
desc: MitM core.tantanapp.com：开屏策略改写为空广告位，其余广告接口回空 JSON

http:
  mitm:
    - core.tantanapp.com

  url-rewrite:
    # 广告数据 / 素材清单 / 设备广告标识（不含 configuration，那条走 script）
    - ^https?://core\.tantanapp\.com/v2/ad-data - reject-dict
    - ^https?://core\.tantanapp\.com/v2/ad/aaid - reject-dict
    - ^https?://core\.tantanapp\.com/v2/ad/material/ - reject-dict
    # 广告创意清单（2026-10-20 新增）
    - ^https?://core\.tantanapp\.com/v2/oms/me/creatives - reject-dict
    # 推广位与变现策略
    - ^https?://core\.tantanapp\.com/v2/monetization-promotions - reject-dict
    - ^https?://core\.tantanapp\.com/v2/monetization/strategy/configuration - reject-dict
    - ^https?://core\.tantanapp\.com/v2/users/[^/]+/advert/ - reject-dict

  script:
    # 开屏策略：原样结构 + 清空 placementId（脚本内容见 scripts/tantan-ad-config.js）
    - match: ^https?://core\.tantanapp\.com/v2/ad/configuration$
      name: tantan-ad-config
      type: response
      require-body: true

script-providers:
  tantan-ad-config:
    # 内联，避免远程下载失败导致脚本不生效（与 scripts/tantan-ad-config.js 同源）
    payload: |
      // 探探开屏广告配置改写（Stash / Surge 脚本）
      //
      // 目标接口：POST https://core.tantanapp.com/v2/ad/configuration
      // 原始响应（2026-10-20 抓包，435 B）：
      //   {"data":{"adConfiguration":{"adSplash":{
      //     "coldStart":{"selectMethod":"bidding","sdkConfig":{"gdt":{"placementId":"6019582857899966","basePrice":100},"momo":{"placementId":"","basePrice":0}}},
      //     "hotStart":{"selectMethod":"bidding","sdkConfig":{"gdt":{"placementId":"5029488867197998","basePrice":100}}},
      //     "ext":{"shakeWeakenSwitch":false,...}}}},"meta":{"code":200,"message":"OK"}}
      //
      // 做法：保留结构，清空 GDT / 陌陌的 placementId（没有广告位就没得竞价），
      // 比直接 reject-dict 回 "{}" 更安全 —— App 拿不到合法结构时可能回退到内置默认配置。
      //
      // 注意：selectMethod 保留 "bidding"（已知合法枚举），不改成 "none"，避免未知枚举导致解析失败。
      const body = {
        data: {
          adConfiguration: {
            adSplash: {
              coldStart: {
                selectMethod: 'bidding',
                sdkConfig: {
                  gdt: { placementId: '', basePrice: 0 },
                  momo: { placementId: '', basePrice: 0 }
                }
              },
              hotStart: {
                selectMethod: 'bidding',
                sdkConfig: {
                  gdt: { placementId: '', basePrice: 0 },
                  momo: { placementId: '', basePrice: 0 }
                }
              },
              ext: { shakeWeakenSwitch: false, degree: 0, interval: 0 }
            }
          }
        },
        meta: { code: 200, message: 'OK' }
      };
      
      $done({ body: JSON.stringify(body) });
